# GEMINI_API_KEY: Diperlukan untuk pemanggilan Gemini AI API (server-side).
# Di AI Studio: Diinjeksi otomatis dari menu Secrets.
# Di Vercel: Tambahkan variabel ini di Project Settings > Environment Variables.
# Dapatkan API Key gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL aplikasi (opsional).
# Di Vercel: https://nama-proyek-anda.vercel.app
APP_URL="MY_APP_URL"
